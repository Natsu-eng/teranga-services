# Copy this file to .env.local and fill in your own key for local development.
# .env.local is gitignored and takes precedence over .env (see server.ts).
#
# Optional: without a real key (or left as the placeholder below), the
# /api/analyze-problem endpoint falls back to a heuristic keyword match
# instead of calling Gemini.
GEMINI_API_KEY=

# Optional: base URL of the FastAPI backend, used only by the dev proxy in
# server.ts for /api/v1/* (never read by browser code). Defaults to
# http://localhost:8000, matching `uv run uvicorn app.main:app --reload
# --port 8000` in backend/README.md.
BACKEND_URL=http://localhost:8000
