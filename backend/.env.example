# Copier ce fichier vers .env pour le développement local.
# .env est gitignore (règle .env* à la racine du repo) — n'y mettez jamais ce
# fichier en dur, il ne doit jamais être commité.

# URL de connexion PostgreSQL, driver asyncpg obligatoire (SQLAlchemy async).
# Aucune valeur par défaut n'existe dans le code : le démarrage échoue
# explicitement si cette variable est absente ou malformée.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teranga

# Environnement d'exécution : dev | staging | prod
# Contrôle le format des logs (lisible en dev, JSON structuré en prod).
APP_ENV=dev

# Niveau de log standard Python : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Origines autorisées pour CORS, séparées par des virgules. Pas de wildcard.
# Ex. pour le frontend Vite en dev local :
CORS_ORIGINS=http://localhost:3000

# --- Authentification (Lot 8) ------------------------------------------

# Secret de signature des JWT (access + refresh). Obligatoire, aucune
# valeur par défaut : le démarrage échoue explicitement si absente ou trop
# courte (minimum 32 caractères) -- même principe fail-fast que DATABASE_URL.
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Durée de vie de l'access token, en secondes. Défaut 15 min : court, car
# jamais révocable individuellement (JWT stateless).
JWT_ACCESS_TTL_SECONDS=900

# Durée de vie du refresh token, en secondes. Défaut 30 jours : long, car
# révocable (table refresh_token) et soumis à rotation à chaque /refresh.
JWT_REFRESH_TTL_SECONDS=2592000

# Fournisseur d'envoi de SMS pour l'OTP : console | unconfigured
# "console" (dev) journalise le code en clair, uniquement si APP_ENV=dev.
# "unconfigured" échoue explicitement à l'envoi -- aucun fournisseur SMS
# commercial n'est encore branché, ce choix reste à trancher avant la prod.
SMS_PROVIDER=console

# Région par défaut pour interpréter un numéro écrit sans indicatif
# (code ISO 3166-1 alpha-2, ex. "771234567" -> Sénégal).
PHONE_DEFAULT_REGION=SN

# Régions dont les numéros sont acceptés, séparées par des virgules. Un
# numéro valide mais d'une région absente de cette liste est rejeté.
PHONE_ALLOWED_REGIONS=SN

# Longueur du code OTP (chiffres). 6 est le standard de l'industrie.
OTP_CODE_LENGTH=6

# TTL du code OTP, en secondes. Défaut 5 min.
OTP_TTL_SECONDS=300

# Tentatives de vérification autorisées avant invalidation du code.
OTP_MAX_ATTEMPTS=5

# Itérations PBKDF2-HMAC-SHA256 pour le hachage du code OTP. 600 000 est la
# recommandation OWASP (2023) pour PBKDF2-SHA256.
OTP_HASH_ITERATIONS=600000

# Rate limiting sur POST /auth/request-otp, fenêtre glissante EN MÉMOIRE
# (voir app/services/rate_limit.py -- dette documentée pour Railway : ne
# survit ni à un redémarrage, ni à plusieurs instances/workers).
RATE_LIMIT_OTP_PER_PHONE_MAX=3
RATE_LIMIT_OTP_PER_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_PER_IP_MAX=10
RATE_LIMIT_OTP_PER_IP_WINDOW_SECONDS=600
