# Copier ce fichier vers .env pour le développement local.
# .env est gitignore (règle .env* à la racine du repo) — n'y mettez jamais ce
# fichier en dur, il ne doit jamais être commité.

# URL de connexion PostgreSQL, driver asyncpg obligatoire (SQLAlchemy async).
# Aucune valeur par défaut n'existe dans le code : le démarrage échoue
# explicitement si cette variable est absente ou malformée.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teranga

# Environnement d'exécution, ensemble fermé :
#   development (défaut) | test | staging | production
# Toute autre valeur fait échouer le démarrage. En production, le démarrage
# échoue aussi si un secret manque ou garde une valeur d'exemple, si un
# fournisseur de dev est configuré (SMS console, paiement sandbox, stockage
# local) ou si une URL publique n'est pas en HTTPS -- voir DEPLOYMENT.md.
# Logs lisibles en development/test, JSON structuré en staging/production.
# L'ancien nom APP_ENV (valeurs dev/staging/prod) reste accepté.
ENVIRONMENT=development

# Niveau de log standard Python : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Origines autorisées pour CORS, séparées par des virgules. Jamais de joker
# « * » (refusé au démarrage) ; chaque entrée est une origine exacte
# (https://hote[:port], sans chemin ni « / » final, refusé sinon).
# En dev, le front passe par le proxy Vite (même origine) : CORS n'est sollicité
# que si le navigateur appelle le backend directement. En production avec
# VITE_API_BASE_URL absolue (front et back sur deux origines), y mettre
# l'origine exacte du front, ex. https://teranga.vercel.app -- le démarrage en
# production échoue si elle manque ou si une origine n'est pas en HTTPS.
CORS_ORIGINS=http://localhost:3000

# --- Authentification (Lot 8) ------------------------------------------

# Secret de signature des JWT (access + refresh). Obligatoire, aucune
# valeur par défaut : le démarrage échoue explicitement si absente ou trop
# courte (minimum 32 caractères) -- même principe fail-fast que DATABASE_URL.
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Durée de vie de l'access token, en secondes. Défaut 15 min : court, car
# jamais révocable individuellement (JWT stateless).
JWT_ACCESS_TTL_SECONDS=900

# Durée de vie du refresh token, en secondes. Défaut 30 jours : long, car
# révocable (table refresh_token) et soumis à rotation à chaque /refresh.
JWT_REFRESH_TTL_SECONDS=2592000

# Canal de livraison des codes OTP : console | termii | unconfigured
# (génération, hachage et vérification restent les nôtres).
# "console" (dev) journalise le code en clair, uniquement en development/test.
# "termii" : envoi réel par l'API Termii (variables TERMII_* ci-dessous).
# "unconfigured" échoue explicitement à l'envoi.
# En production, "console" et "unconfigured" sont refusés au démarrage.
SMS_PROVIDER=console

# --- Termii (SMS_PROVIDER=termii, DEPLOYMENT.md) ------------------------
# Les trois premières sont obligatoires avec SMS_PROVIDER=termii (refus au
# démarrage sinon, avec la liste des variables en cause).
# Clé d'API : tableau de bord Termii, Settings > API token. SECRET.
TERMII_API_KEY=
# Identifiant d'expéditeur enregistré chez Termii, 3 à 11 caractères alphanumériques.
TERMII_SENDER_ID=
# Base de l'API PROPRE AU COMPTE, copiée du tableau de bord Termii (Settings >
# API token), en https://. Pas de valeur par défaut : Termii route chaque
# compte vers sa région réglementaire.
TERMII_BASE_URL=
# Expéditeur WhatsApp (nom de l'appareil chez Termii) ; vide = TERMII_SENDER_ID.
TERMII_WHATSAPP_SENDER=
# Délai d'un appel (s), essais par canal (1 à 3), budget total de l'envoi (s).
# Le budget total doit rester sous les 10 s du front pour un appel court.
TERMII_TIMEOUT_SECONDS=4.0
TERMII_MAX_ATTEMPTS=2
TERMII_TOTAL_TIMEOUT_SECONDS=8.0
# Valeur `channel` de Termii pour un code WhatsApp : whatsapp_otp (canal de
# code documenté par Termii, à faire activer par leur support) | whatsapp.
TERMII_WHATSAPP_CHANNEL=whatsapp_otp

# Route SMS des codes : dnd (transactionnelle, passe même en liste
# anti-publicité) | generic.
OTP_SMS_CHANNEL=dnd
# Canal des codes : sms | whatsapp | whatsapp_then_sms (WhatsApp puis repli SMS).
OTP_CHANNEL=sms

# --- E-mails aux administrateurs (DEPLOYMENT.md, « E-mails ») -------------
# Notification quand un artisan COMPLÈTE son dossier de vérification (un
# e-mail par passage en attente de revue, jamais un par document).
# Fournisseur : console (défaut : rien n'est envoyé, seulement journalisé)
# | brevo (API HTTP, port 443 : la voie à utiliser sur Render)
# | smtp (envoi réel par SMTP : INUTILISABLE sur Render, ports SMTP bloqués).
# Best-effort : un échec d'e-mail n'empêche jamais l'envoi des documents.
EMAIL_PROVIDER=console

# --- Brevo (EMAIL_PROVIDER=brevo) ---------------------------------------
# Clé d'API : Brevo > SMTP & API > Clés API. SECRET (obligatoire avec brevo).
BREVO_API_KEY=
# Base de l'API (documentation Brevo) et délai maximal d'un appel (s).
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_TIMEOUT_SECONDS=10
# Serveur SMTP (obligatoires avec EMAIL_PROVIDER=smtp, sauf le port).
# Gmail : smtp.gmail.com, port 587, STARTTLS, et un MOT DE PASSE
# D'APPLICATION (compte Google > Sécurité > Validation en deux étapes >
# Mots de passe des applications), jamais le mot de passe du compte.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465).
SMTP_SECURITY=starttls
SMTP_USER=
# SECRET : jamais dans le dépôt, uniquement dans les variables du service.
SMTP_PASSWORD=
# Délai maximal d'un envoi, en secondes.
SMTP_TIMEOUT_SECONDS=10
# Expéditeur (smtp et brevo). Avec Gmail en SMTP : l'adresse du compte
# lui-même ; avec Brevo : une adresse VALIDÉE dans le compte Brevo
# (Expéditeurs, domaines et IP dédiées).
EMAIL_FROM=
# Destinataires des notifications d'administration, séparés par des virgules.
ADMIN_NOTIFICATION_EMAILS=

# Région par défaut pour interpréter un numéro écrit sans indicatif
# (code ISO 3166-1 alpha-2, ex. "771234567" -> Sénégal).
PHONE_DEFAULT_REGION=SN

# Régions dont les numéros sont acceptés, séparées par des virgules. Un
# numéro valide mais d'une région absente de cette liste est rejeté.
PHONE_ALLOWED_REGIONS=SN

# Longueur du code OTP (chiffres). 6 est le standard de l'industrie.
OTP_CODE_LENGTH=6

# TTL du code OTP, en secondes. Défaut 5 min.
OTP_TTL_SECONDS=300

# Tentatives de vérification autorisées avant invalidation du code.
OTP_MAX_ATTEMPTS=5

# Itérations PBKDF2-HMAC-SHA256 pour le hachage du code OTP. 600 000 est la
# recommandation OWASP (2023) pour PBKDF2-SHA256.
OTP_HASH_ITERATIONS=600000

# --- Mode OTP de TEST (beta, DEPLOYMENT.md « Beta de test ») ------------
# UNIQUEMENT avec ENVIRONMENT=staging : refusé au démarrage partout ailleurs,
# production comprise. Pour un numéro de la liste, aucun SMS n'est envoyé et
# le code de connexion est OTP_TEST_CODE ; tout le reste (hachage, usage
# unique, expiration, tentatives, rate limiting) est inchangé. Les numéros
# hors liste suivent le flux normal. Exige SMS_PROVIDER=console tant
# qu'aucun fournisseur réel n'est branché (`unconfigured` est refusé : ses
# erreurs révéleraient quels numéros sont sur la liste).
# Numéros E.164 séparés par des virgules, ex. +221770000001,+221770000002.
# Préférez des numéros dédiés aux tests plutôt que de vrais numéros.
OTP_TEST_WHITELIST=
# Exactement OTP_CODE_LENGTH chiffres ; à transmettre aux seuls testeurs.
OTP_TEST_CODE=

# Redis partagé (redis:// ou rediss://, ex. variable REDIS_URL d'un service
# Redis Railway). Renseigné : rate limiting, diffusion temps réel de la
# messagerie et tickets WebSocket à usage unique sont partagés par toutes
# les instances du backend. Vide (dev) : repli automatique sur la mémoire
# du processus (et PostgreSQL pour le rate limiting hors development/test).
# OBLIGATOIRE dès que le backend tourne sur plus d'une instance.
REDIS_URL=

# Stockage des compteurs de TOUS les rate limitings (OTP, triage IA,
# documents, photos de profil) -- app/services/rate_limit.py :
#   redis    : partagé par toutes les instances (exige REDIS_URL) ;
#   postgres : table rate_limit_hit, partagée par toutes les instances et
#              conservée au redémarrage (clés stockées hachées, jamais en clair).
#   memory   : local au processus -- dev et tests uniquement.
# Vide (recommandé) : redis si REDIS_URL est renseignée, sinon memory en
# development/test et postgres en staging/production. memory est REFUSÉ au
# démarrage en staging/production.
RATE_LIMIT_BACKEND=

# Nombre de proxys de confiance devant le backend, pour retrouver l'IP réelle
# du client dans X-Forwarded-For (lue depuis la DROITE : jamais falsifiable
# par le client). 0 ou vide en dev (accès direct). Railway : 1. OBLIGATOIRE
# en production : sans lui, derrière le proxy, le rate limiting par IP
# mettrait tous les utilisateurs dans un seul compteur.
TRUSTED_PROXY_HOPS=

# Rate limiting sur POST /auth/request-otp, fenêtre glissante.
RATE_LIMIT_OTP_PER_PHONE_MAX=3
RATE_LIMIT_OTP_PER_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_PER_IP_MAX=10
RATE_LIMIT_OTP_PER_IP_WINDOW_SECONDS=600

# --- Recherche géo artisans (Lot 9) --------------------------------------

# Rayon de recherche par défaut si le client ne précise pas radius_m sur
# GET /artisans, en mètres. 10 km couvre la quasi-totalité du Grand Dakar
# depuis un point central.
ARTISAN_SEARCH_DEFAULT_RADIUS_M=10000

# Plafond dur du rayon de recherche, en mètres -- au-delà, une recherche
# perd sa pertinence géo et dégrade la sélectivité de l'index GiST.
ARTISAN_SEARCH_MAX_RADIUS_M=50000

# --- Pagination (Lot 9) --------------------------------------------------
# Offset bornée, réutilisée par GET /artisans et GET /artisans/{id}/reviews.

PAGINATION_PAGE_SIZE_DEFAULT=20
PAGINATION_PAGE_SIZE_MAX=50

# Page maximale autorisée -- au-delà, rejet 422 explicite (PAGE_HORS_BORNES),
# jamais un clamp silencieux.
PAGINATION_MAX_PAGE=50

# --- Vérification artisan (Lot 9) ----------------------------------------

# Types de documents requis pour verified_status=VERIFIED, séparés par des
# virgules (valeurs possibles : cni, selfie, accreditation, address_proof).
# CNI + selfie : preuve d'identité + preuve que la personne qui a soumis la
# CNI en est bien la titulaire -- le socle KYC minimal.
VERIFICATION_REQUIRED_DOC_TYPES=cni,selfie

# --- Triage IA (Lot 11) ----------------------------------------------------
# POST /api/v1/ai/analyze -- SEULE implémentation du triage IA du projet
# (l'ancien /api/analyze-problem Express + Gemini et GEMINI_API_KEY ont été
# supprimés au Lot 13 ; le front ne porte plus aucune clé IA). Le fournisseur actif est
# sélectionné par AI_TRIAGE_PROVIDER ; à la moindre anomalie (timeout, erreur
# API, JSON non conforme, métier inconnu), le service retombe automatiquement
# sur l'heuristique -- jamais d'erreur 500 pour un incident IA.

# Fournisseur actif : mistral | heuristic
# "heuristic" (défaut) : filet par mots-clés français, sans appel réseau,
# sans coût, sans clé -- fonctionne toujours, même sans configuration.
# "mistral" : appel réseau réel à l'API Mistral (nécessite MISTRAL_API_KEY).
AI_TRIAGE_PROVIDER=heuristic

# Clé API Mistral. Obligatoire uniquement si AI_TRIAGE_PROVIDER=mistral --
# jamais commitée, jamais de valeur par défaut dans le code. Absente,
# MistralTriageProvider échoue proprement (fallback heuristique) sans
# jamais tenter l'appel réseau.
MISTRAL_API_KEY=

# Modèle Mistral utilisé pour le triage. Un modèle économique (gamme
# "small") suffit pour cette tâche de classification/estimation courte.
MISTRAL_MODEL=mistral-small-latest

# URL de base de l'API Mistral (change rarement, mais jamais codée en dur).
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Timeout explicite sur l'appel Mistral, en secondes -- au-delà, fallback
# heuristique plutôt que de faire attendre indéfiniment la requête cliente.
MISTRAL_TIMEOUT_SECONDS=10

# Rate limiting sur POST /api/v1/ai/analyze, fenêtre glissante EN MÉMOIRE
# (même mécanisme que RATE_LIMIT_OTP_*, voir app/services/rate_limit.py).
# Par IP uniquement : l'endpoint est public, non authentifié (l'écran
# /demande ne requiert pas de connexion). Chaque appel routé vers un
# fournisseur réseau coûte potentiellement de l'argent réel.
RATE_LIMIT_AI_ANALYZE_PER_IP_MAX=20
RATE_LIMIT_AI_ANALYZE_PER_IP_WINDOW_SECONDS=600

# --- Stockage des documents de vérification (onboarding artisan) ---------
# Couche d'abstraction (app/services/storage.py), même principe que
# SMS_PROVIDER/AI_TRIAGE_PROVIDER : le code appelant ne connaît que
# l'interface StorageBackend, jamais son implémentation concrète.

# Fournisseur actif, pour TOUS les fichiers (documents, photos de profil,
# photos de la messagerie), sauf variante précisée plus bas :
#   local : disque local (dev, défaut) ;
#   s3    : stockage S3-compatible (Cloudflare R2, AWS S3...), variables S3_*
#           ci-dessous. OBLIGATOIRE en production : le disque d'un service
#           Railway est éphémère, tout fichier local serait PERDU au prochain
#           déploiement. "local" est refusé au démarrage en production.
STORAGE_BACKEND=local

# --- Stockage S3-compatible (STORAGE_BACKEND=s3) --------------------------
# Deux buckets DIFFÉRENTS (refusé au démarrage sinon) :
#   - privé : documents d'identité et photos de la messagerie, aucun accès
#     public, servis uniquement par les endpoints authentifiés ;
#   - public : photos de profil et de couverture seulement.
# Blancs et caractères invisibles en bordure (retour à la ligne d'un
# copier-coller...) retirés de toutes les variables S3_* ; une valeur encore
# invalide arrête le démarrage avec la liste des variables en cause.
# Point d'accès : vide pour AWS S3 ; R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Région : auto pour R2, la région du bucket pour AWS (ex. eu-west-3).
S3_REGION=auto
# Clé d'API du stockage (droits lecture/écriture sur les deux buckets).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=
S3_PUBLIC_BUCKET=
# URL publique HTTPS du bucket public (domaine personnalisé R2 ou CDN),
# base des URL de photos de profil renvoyées au front.
S3_PUBLIC_BASE_URL=
# Adressage « path-style » (https://endpoint/bucket/clé). Vide (défaut) :
# activé automatiquement dès que S3_ENDPOINT_URL est renseigné -- EXIGÉ par
# Supabase Storage et MinIO, toléré par R2 ; sans endpoint (AWS S3), choix
# de boto3 inchangé. true / false pour forcer (rarement utile).
S3_FORCE_PATH_STYLE=

# Répertoire de stockage local (relatif au dossier backend/, ou chemin
# absolu). Défaut hors du code source, ignoré par backend/.gitignore,
# jamais servi statiquement. Pour une isolation plus stricte (répertoire
# littéralement hors du dépôt), fournir un chemin absolu.
STORAGE_LOCAL_DIR=var/artisan-documents

# Taille maximale d'un document uploadé, en octets. Défaut 8 Mo.
STORAGE_MAX_UPLOAD_BYTES=8388608

# Rate limiting sur POST /api/v1/artisans/me/documents, par utilisateur
# authentifié (fenêtre glissante en mémoire, même mécanisme que
# RATE_LIMIT_OTP_*).
RATE_LIMIT_DOCUMENT_UPLOAD_PER_USER_MAX=10
RATE_LIMIT_DOCUMENT_UPLOAD_PER_USER_WINDOW_SECONDS=600

# --- Stockage de la photo de profil artisan (onboarding artisan) ---------
# Volontairement distinct du stockage privé ci-dessus (documents de
# vérification) : une photo de profil est publique (recherche, profil
# détaillé), servie via /static/avatars (StaticFiles, app/main.py).

# Fournisseur : local | s3 (bucket PUBLIC). Vide : même valeur que
# STORAGE_BACKEND. En s3, plus rien n'est servi par /static/avatars.
AVATAR_STORAGE_BACKEND=

# Répertoire local monté en lecture publique. JAMAIS le même répertoire que
# STORAGE_LOCAL_DIR (documents privés).
AVATAR_STORAGE_LOCAL_DIR=var/public/avatars

# Taille maximale du FICHIER envoyé pour la photo de profil / de
# couverture, en octets (défaut 10 Mo). Ce qui est servi publiquement est
# toujours réencodé et redimensionné (app/services/image_processing.py) :
# quelques centaines de Ko, quelle que soit la taille envoyée. Le front lit
# ces valeurs via GET /api/v1/artisans/me/media-constraints -- rien à
# changer côté front quand on les modifie.
AVATAR_MAX_UPLOAD_BYTES=10485760
COVER_MAX_UPLOAD_BYTES=10485760

# Côté le plus long de l'image servie, en pixels (jamais d'agrandissement).
AVATAR_MAX_SIDE_PX=512
COVER_MAX_SIDE_PX=1600

# Plafond de pixels (largeur x hauteur) d'une image envoyée, lu dans son
# en-tête avant décodage -- protection contre les bombes de décompression.
PROFILE_MEDIA_MAX_PIXELS=50000000

# Rate limiting sur POST /api/v1/artisans/me/avatar et .../me/cover, budget
# partagé entre les deux (même clé par utilisateur authentifié).
RATE_LIMIT_PROFILE_MEDIA_UPLOAD_PER_USER_MAX=20
RATE_LIMIT_PROFILE_MEDIA_UPLOAD_PER_USER_WINDOW_SECONDS=600

# Origine publique du backend, utilisée pour construire l'URL absolue d'un
# avatar. En prod, front (Vercel) et back (Railway) sont deux services sur
# des origines différentes -- à renseigner avec l'URL réelle du backend.
BACKEND_PUBLIC_BASE_URL=http://localhost:8000

# --- Messagerie (BUILD_PLAN.md §3.4) --------------------------------------
# Longueur maximale d'un message, légende de photo comprise (caractères).
MESSAGING_BODY_MAX_LENGTH=2000

# Pagination de l'historique (GET /conversations/{id}/messages).
MESSAGING_HISTORY_PAGE_SIZE_DEFAULT=30
MESSAGING_HISTORY_PAGE_SIZE_MAX=100

# Rate limiting de l'envoi de messages texte, par utilisateur authentifié.
RATE_LIMIT_MESSAGE_SEND_PER_USER_MAX=30
RATE_LIMIT_MESSAGE_SEND_PER_USER_WINDOW_SECONDS=60

# Photos de la messagerie : stockage PRIVÉ (jamais servi en statique),
# lecture réservée aux deux participants. JAMAIS le même répertoire que
# AVATAR_STORAGE_LOCAL_DIR (public). Fournisseur : local | s3 (bucket PRIVÉ) ;
# vide : même valeur que STORAGE_BACKEND.
MESSAGE_ATTACHMENT_STORAGE_BACKEND=
MESSAGE_ATTACHMENT_STORAGE_LOCAL_DIR=var/message-attachments

# Fichier envoyé (octets, 10 Mo), côté le plus long après réencodage, et
# plafond de pixels vérifié avant décodage (anti-bombe de décompression).
MESSAGE_ATTACHMENT_MAX_UPLOAD_BYTES=10485760
MESSAGE_ATTACHMENT_MAX_SIDE_PX=1600
MESSAGE_ATTACHMENT_MAX_PIXELS=50000000

# Rate limiting de l'envoi de photos, par utilisateur authentifié.
RATE_LIMIT_MESSAGE_ATTACHMENT_PER_USER_MAX=20
RATE_LIMIT_MESSAGE_ATTACHMENT_PER_USER_WINDOW_SECONDS=600

# --- Temps réel (WebSocket /api/v1/realtime/ws) ---------------------------
# Durée de vie du ticket d'ouverture (usage unique), en secondes.
WS_TICKET_TTL_SECONDS=60

# Ping serveur toutes les N secondes ; connexion fermée sans signe du
# client pendant le délai d'expiration.
WS_HEARTBEAT_INTERVAL_SECONDS=25
WS_HEARTBEAT_TIMEOUT_SECONDS=60

# Connexions simultanées par utilisateur (onglets) ; au-delà, la plus
# ancienne est fermée.
WS_MAX_CONNECTIONS_PER_USER=5

# --- Notifications push (Web Push, DEPLOYMENT.md §15) ----------------------
# Nouveau message -> notification sur l'appareil du destinataire, même app
# fermée. false (défaut) : aucun abonnement accepté, aucun envoi.
# true : les trois VAPID_* sont exigés au démarrage (paire cohérente).
WEB_PUSH_ENABLED=false
# Paire de clés : uv run python scripts/generate_vapid_keys.py (une paire par
# environnement). VAPID_PRIVATE_KEY = SECRET, jamais dans le dépôt.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact transmis aux services de push : mailto:adresse ou https://...
VAPID_SUBJECT=
# Conservation par le service de push si l'appareil est hors ligne (secondes).
WEB_PUSH_TTL_SECONDS=86400
WEB_PUSH_TIMEOUT_SECONDS=10
# Appareils abonnés par compte ; au-delà, le plus ancien est oublié.
WEB_PUSH_MAX_SUBSCRIPTIONS_PER_USER=10
# Hôtes des services de push acceptés pour un abonnement (anti-SSRF), en
# nom exact ou suffixe. Défaut : FCM, Mozilla, Apple, Windows.
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
# Rate limiting des (dés)abonnements, par utilisateur authentifié.
RATE_LIMIT_PUSH_SUBSCRIPTION_PER_USER_MAX=20
RATE_LIMIT_PUSH_SUBSCRIPTION_PER_USER_WINDOW_SECONDS=600

# --- Paiements (BUILD_PLAN.md §3.5) ---------------------------------------
# Règle d'arrondi de la commission : floor (défaut, en faveur de l'artisan :
# jamais plus que le taux annoncé, écart max 1 FCFA), half_up ou ceil.
COMMISSION_ROUNDING=floor

# Plafond de saisie d'un nouveau taux de commission dans le back-office, en
# points de base (3000 = 30 %) : garde-fou contre une faute de frappe. Ne
# modifie aucun taux existant.
COMMISSION_RATE_MAX_BPS=3000

# Fournisseur de paiement actif -- LE point de bascule sandbox -> réel.
# sandbox : reproduit le contrat d'un agrégateur, sans argent réel
#           (interdit en production) ;
# disabled : paiement en ligne coupé, espèces seules enregistrables.
PAYMENT_PROVIDER=sandbox

# Secret de signature des webhooks (HMAC-SHA256), fourni par l'agrégateur.
# Obligatoire (32 caractères min.) hors dev ; en dev avec le sandbox, laissé
# vide il est dérivé de JWT_SECRET.
PAYMENT_WEBHOOK_SECRET=

# Écart toléré entre l'horodatage signé d'un webhook et l'horloge serveur.
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Taille maximale du corps d'un webhook (octets).
PAYMENT_WEBHOOK_MAX_BODY_BYTES=65536
# Durée de validité d'une page de paiement (secondes).
PAYMENT_CHECKOUT_TTL_SECONDS=1800
# Devise unique (franc CFA BCEAO, montants entiers) : seule valeur admise.
PAYMENT_CURRENCY=XOF
# Moyens de paiement en ligne proposés (séparés par des virgules).
PAYMENT_ONLINE_CHANNELS=wave,orange_money,carte
# Espèces enregistrables (pas de séquestre, commission due par l'artisan).
PAYMENT_CASH_ENABLED=true
# Délai maximal d'un appel au fournisseur (secondes).
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10

# Versements : moyen par défaut et moyens que l'artisan peut choisir --
# toujours vers le numéro vérifié de son compte.
PAYOUT_DEFAULT_CHANNEL=wave
PAYOUT_ALLOWED_CHANNELS=wave,orange_money

# Rate limiting de POST /api/v1/payments/init, par utilisateur.
RATE_LIMIT_PAYMENT_INIT_PER_USER_MAX=10
RATE_LIMIT_PAYMENT_INIT_PER_USER_WINDOW_SECONDS=600

# Origine publique du front : pages de retour après un paiement (jamais une
# URL fournie par le client).
FRONTEND_PUBLIC_BASE_URL=http://localhost:3000

# Sandbox uniquement : où livrer les webhooks simulés. Vide =
# {BACKEND_PUBLIC_BASE_URL}/api/v1/webhooks/payments.
SANDBOX_WEBHOOK_URL=

# --- Demandes ---------------------------------------------------------------
# Durée de vie d'une demande restée OUVERTE (aucun artisan ne l'a reçue), en
# jours : au-delà elle est expirée. Appliqué d'office ; enregistré en base par
# scripts/expire_requests.py (à planifier une fois par jour).
REQUEST_OPEN_TTL_DAYS=30
