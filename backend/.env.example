# Copier ce fichier vers .env pour le développement local.
# .env est gitignore (règle .env* à la racine du repo) — n'y mettez jamais ce
# fichier en dur, il ne doit jamais être commité.

# URL de connexion PostgreSQL, driver asyncpg obligatoire (SQLAlchemy async).
# Aucune valeur par défaut n'existe dans le code : le démarrage échoue
# explicitement si cette variable est absente ou malformée.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/teranga

# Environnement d'exécution : dev | staging | prod
# Contrôle le format des logs (lisible en dev, JSON structuré en prod).
APP_ENV=dev

# Niveau de log standard Python : DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Origines autorisées pour CORS, séparées par des virgules. Pas de wildcard.
# Ex. pour le frontend Vite en dev local :
CORS_ORIGINS=http://localhost:3000

# --- Authentification (Lot 8) ------------------------------------------

# Secret de signature des JWT (access + refresh). Obligatoire, aucune
# valeur par défaut : le démarrage échoue explicitement si absente ou trop
# courte (minimum 32 caractères) -- même principe fail-fast que DATABASE_URL.
# Générer une valeur : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Durée de vie de l'access token, en secondes. Défaut 15 min : court, car
# jamais révocable individuellement (JWT stateless).
JWT_ACCESS_TTL_SECONDS=900

# Durée de vie du refresh token, en secondes. Défaut 30 jours : long, car
# révocable (table refresh_token) et soumis à rotation à chaque /refresh.
JWT_REFRESH_TTL_SECONDS=2592000

# Fournisseur d'envoi de SMS pour l'OTP : console | unconfigured
# "console" (dev) journalise le code en clair, uniquement si APP_ENV=dev.
# "unconfigured" échoue explicitement à l'envoi -- aucun fournisseur SMS
# commercial n'est encore branché, ce choix reste à trancher avant la prod.
SMS_PROVIDER=console

# Région par défaut pour interpréter un numéro écrit sans indicatif
# (code ISO 3166-1 alpha-2, ex. "771234567" -> Sénégal).
PHONE_DEFAULT_REGION=SN

# Régions dont les numéros sont acceptés, séparées par des virgules. Un
# numéro valide mais d'une région absente de cette liste est rejeté.
PHONE_ALLOWED_REGIONS=SN

# Longueur du code OTP (chiffres). 6 est le standard de l'industrie.
OTP_CODE_LENGTH=6

# TTL du code OTP, en secondes. Défaut 5 min.
OTP_TTL_SECONDS=300

# Tentatives de vérification autorisées avant invalidation du code.
OTP_MAX_ATTEMPTS=5

# Itérations PBKDF2-HMAC-SHA256 pour le hachage du code OTP. 600 000 est la
# recommandation OWASP (2023) pour PBKDF2-SHA256.
OTP_HASH_ITERATIONS=600000

# Rate limiting sur POST /auth/request-otp, fenêtre glissante EN MÉMOIRE
# (voir app/services/rate_limit.py -- dette documentée pour Railway : ne
# survit ni à un redémarrage, ni à plusieurs instances/workers).
RATE_LIMIT_OTP_PER_PHONE_MAX=3
RATE_LIMIT_OTP_PER_PHONE_WINDOW_SECONDS=600
RATE_LIMIT_OTP_PER_IP_MAX=10
RATE_LIMIT_OTP_PER_IP_WINDOW_SECONDS=600

# --- Recherche géo artisans (Lot 9) --------------------------------------

# Rayon de recherche par défaut si le client ne précise pas radius_m sur
# GET /artisans, en mètres. 10 km couvre la quasi-totalité du Grand Dakar
# depuis un point central.
ARTISAN_SEARCH_DEFAULT_RADIUS_M=10000

# Plafond dur du rayon de recherche, en mètres -- au-delà, une recherche
# perd sa pertinence géo et dégrade la sélectivité de l'index GiST.
ARTISAN_SEARCH_MAX_RADIUS_M=50000

# --- Pagination (Lot 9) --------------------------------------------------
# Offset bornée, réutilisée par GET /artisans et GET /artisans/{id}/reviews.

PAGINATION_PAGE_SIZE_DEFAULT=20
PAGINATION_PAGE_SIZE_MAX=50

# Page maximale autorisée -- au-delà, rejet 422 explicite (PAGE_HORS_BORNES),
# jamais un clamp silencieux.
PAGINATION_MAX_PAGE=50

# --- Vérification artisan (Lot 9) ----------------------------------------

# Types de documents requis pour verified_status=VERIFIED, séparés par des
# virgules (valeurs possibles : cni, selfie, accreditation, address_proof).
# CNI + selfie : preuve d'identité + preuve que la personne qui a soumis la
# CNI en est bien la titulaire -- le socle KYC minimal.
VERIFICATION_REQUIRED_DOC_TYPES=cni,selfie

# --- Triage IA (Lot 11) ----------------------------------------------------
# POST /api/v1/ai/analyze, migration provider-agnostique de l'ancien
# /api/analyze-problem (Express + Gemini). Le fournisseur actif est
# sélectionné par AI_TRIAGE_PROVIDER ; à la moindre anomalie (timeout, erreur
# API, JSON non conforme, métier inconnu), le service retombe automatiquement
# sur l'heuristique -- jamais d'erreur 500 pour un incident IA.

# Fournisseur actif : mistral | heuristic
# "heuristic" (défaut) : filet par mots-clés français, sans appel réseau,
# sans coût, sans clé -- fonctionne toujours, même sans configuration.
# "mistral" : appel réseau réel à l'API Mistral (nécessite MISTRAL_API_KEY).
AI_TRIAGE_PROVIDER=heuristic

# Clé API Mistral. Obligatoire uniquement si AI_TRIAGE_PROVIDER=mistral --
# jamais commitée, jamais de valeur par défaut dans le code. Absente,
# MistralTriageProvider échoue proprement (fallback heuristique) sans
# jamais tenter l'appel réseau.
MISTRAL_API_KEY=

# Modèle Mistral utilisé pour le triage. Un modèle économique (gamme
# "small") suffit pour cette tâche de classification/estimation courte.
MISTRAL_MODEL=mistral-small-latest

# URL de base de l'API Mistral (change rarement, mais jamais codée en dur).
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# Timeout explicite sur l'appel Mistral, en secondes -- au-delà, fallback
# heuristique plutôt que de faire attendre indéfiniment la requête cliente.
MISTRAL_TIMEOUT_SECONDS=10

# Rate limiting sur POST /api/v1/ai/analyze, fenêtre glissante EN MÉMOIRE
# (même mécanisme que RATE_LIMIT_OTP_*, voir app/services/rate_limit.py).
# Par IP uniquement : l'endpoint est public, non authentifié (l'écran
# /demande ne requiert pas de connexion). Chaque appel routé vers un
# fournisseur réseau coûte potentiellement de l'argent réel.
RATE_LIMIT_AI_ANALYZE_PER_IP_MAX=20
RATE_LIMIT_AI_ANALYZE_PER_IP_WINDOW_SECONDS=600
